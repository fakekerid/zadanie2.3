<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="okno.MainWindow"
        Title="Warsztat"
        Width="500" Height="400"
        Background="#F6E7C1">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Warsztat" FontSize="28" FontWeight="Bold" Foreground="#3E2723" HorizontalAlignment="Center" />
        <TextBlock Text="Edycja druga z agentem" FontSize="14" Foreground="#5D4037" HorizontalAlignment="Center" />
        <Button Content="Kliknij mnie" HorizontalAlignment="Center" />
    </StackPanel>
</Window>
